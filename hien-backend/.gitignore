# =============================================================
# HIEN Backend — .gitignore
# =============================================================

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & credentials (NEVER commit!)
.env
.env.local
.env.*.local
*.env
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Archives & Temporary files
*.zip
*.tar.gz
dist/
build/
*.egg-info/
*.log

# Local database mount (if any)
pgdata/
