# =============================================================
# HIEN Backend — Environment Variables Template
# =============================================================
# Copy this file to .env and adjust values for your environment:
#
#   cp .env.example .env
# =============================================================

# --- Environment Mode ----------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# --- Option A: Supabase Cloud PostgreSQL (Session Pooler) ----
# Host: aws-0-ap-southeast-1.pooler.supabase.com (Port 5432)
# Username: postgres.zrskclaymemxmrducoqx
# Note: If your password contains special characters (@, #, %, etc.),
# URL-encode them (e.g., '@' -> '%40') or set SUPABASE_DB_PASSWORD below.
DATABASE_URL=postgresql://postgres.zrskclaymemxmrducoqx:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Alternatively, set your password separately to allow auto-encoding:
# SUPABASE_DB_PASSWORD=[YOUR_PASSWORD]

# --- Option B: Local PostgreSQL / PostGIS (Docker Compose) ---
# POSTGRES_DB=hien
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change_this_password
# DATABASE_URL=postgresql://postgres:change_this_password@postgres:5432/hien

# --- Connection Pool Tuning (Optional) -----------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- CORS Settings -------------------------------------------
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security & Cron Protection (Optional) -------------------
# Secret key to secure /api/v1/cron/price-decay endpoint
CRON_SECRET=
