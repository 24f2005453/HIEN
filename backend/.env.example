# =============================================================
# HIEN Backend — Environment Variables
# =============================================================
# Copy this file to .env and adjust values as needed.
#
#   cp .env.example .env
#
# These variables are consumed by both Docker Compose and the
# FastAPI application.
# =============================================================

# --- PostgreSQL / PostGIS (used by Docker Compose) -----------
POSTGRES_DB=hien
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password

# --- Database connection (used by FastAPI via database.py) ---
# When running with Docker Compose the host is the service name "postgres".
# When running locally without Docker, change to "localhost".
DATABASE_URL=postgresql://postgres:change_this_password@postgres:5432/hien

# --- CORS (used by FastAPI via main.py) ----------------------
# Comma-separated allowed origins for the React frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
